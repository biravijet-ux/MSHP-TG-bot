# Пример настроек бота.
# Этот файл нужно скопировать в .env и вписать свои значения:
#   cp .env.example .env
# Файл .env в git не попадает, поэтому настоящий токен пишется только туда.

# Токен бота. Выдаёт @BotFather после команды /newbot.
# Нужно заменить на свой токен, он выглядит примерно так: 1234567890:AAH...
BOT_TOKEN=

# Username канала без @, например: mshp_channel
# Из него делаются ссылки на посты: https://t.me/mshp_channel/123
CHANNEL_USERNAME=

# ID канала. Нужен, только если у канала нет username (приватный канал).
# Выглядит как -1001234567890. Узнать можно в Telegram Web (web.telegram.org/a/):
# открыть канал, ID будет в адресной строке после #
CHANNEL_ID=

# Telegram ID админов через запятую. Только им доступны /update_all и /del.
# Свой ID можно узнать у @userinfobot. Пример: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Файл базы данных, где хранятся посты. Создастся сам при первом запуске.
DB_PATH=bot.db

# ---- ИИ для умного поиска (команда "@бот ии запрос" или /ai) ----
# Если AI_API_KEY оставить пустым - ИИ выключен, обычный поиск работает.

# Какой сервис использовать:
#   openai    - OpenAI или любой сервис, который работает с библиотекой openai
#   anthropic - Claude от Anthropic (ключ на console.anthropic.com)
AI_PROVIDER=openai

# Ключ сервиса (для OpenAI - на platform.openai.com)
AI_API_KEY=

# Модель. Я использую gpt-5.4-nano - она дешёвая, а для подбора постов её хватает.
# Для anthropic можно оставить пустым - тогда будет claude-opus-5-5
AI_MODEL=gpt-5.4-nano

# Адрес сервиса, только для AI_PROVIDER=openai. Пусто - сам OpenAI. Примеры:
#   OpenRouter:       https://openrouter.ai/api/v1
#   DeepSeek:         https://api.deepseek.com
#   Ollama (у себя):  http://localhost:11434/v1   (ключ любой, например ollama)
AI_BASE_URL=

# Сколько запросов умного поиска можно сделать за день (на всех вместе)
AI_DAILY_LIMIT=30
